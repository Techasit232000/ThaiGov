#include <iostream>
#include <string>
#include <sstream>
#include <ctime>

struct Telemetry {
    std::string satellite;
    double latitude;
    double longitude;
    double altitude_km;
    double battery_percent;
    double temperature_c;
};

std::string createPacket(const Telemetry& t)
{
    std::ostringstream packet;

    packet << "SAT=THEOS-2A;"
           << "TARGET=ISS;"
           << "LAT=" << t.latitude << ";"
           << "LON=" << t.longitude << ";"
           << "ALT=" << t.altitude_km << ";"
           << "BAT=" << t.battery_percent << ";"
           << "TEMP=" << t.temperature_c;

    return packet.str();
}

void transmitToISSSimulator(const std::string& packet)
{
    std::cout << "\n=== ISS COMMUNICATION SIMULATOR ===\n";
    std::cout << "Receiving packet...\n";
    std::cout << packet << "\n";
    std::cout << "Packet accepted.\n";
}

int main()
{
    Telemetry theos2a;

    theos2a.satellite = "THEOS-2A";
    theos2a.latitude = 13.7563;
    theos2a.longitude = 100.5018;
    theos2a.altitude_km = 550.0;
    theos2a.battery_percent = 94.5;
    theos2a.temperature_c = 21.7;

    std::string packet = createPacket(theos2a);

    std::cout << "THEOS-2A Telemetry System\n";
    std::cout << "Generating telemetry packet...";

    transmitToISSSimulator(packet);

    return 0;
}
