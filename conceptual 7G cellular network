"""7G-SIM: Single-file simulation of a conceptual 7G cellular network.
Provides Radio, Scheduler, UE simulation and a small Flask REST API to
create cells, attach UEs, and get status. Fixed imports and syntax so
it can be run directly: python 7g_sim.py
"""

import threading
import time
from flask import Flask, jsonify, request


class Radio:
    def __init__(self):
        self.cells = {}

    def add_cell(self, cell_id, config=None):
        if cell_id in self.cells:
            return
        self.cells[cell_id] = {
            'id': cell_id,
            'config': config or {},
            'ues': {}
        }

    def register_ue(self, cell_id, ue_id, stats=None):
        if cell_id not in self.cells:
            self.add_cell(cell_id)
        cell = self.cells[cell_id]
        cell['ues'][ue_id] = stats or {'rssi': -80.0, 'throughput': 0.0}

    def update_metrics(self):
        # Simple metric update: small RSSI drift and throughput smoothing
        for cell in self.cells.values():
            for ue in cell['ues'].values():
                ue['rssi'] = ue.get('rssi', -90.0) + 0.1
                ue['throughput'] = max(0.0, ue.get('throughput', 0.0) * 0.98 + 10.0)

    def snapshot(self):
        # Return a deep-ish copy suitable for JSON responses
        return {
            cid: {
                'id': c['id'],
                'config': c['config'],
                'ues': {uid: dict(stats) for uid, stats in c['ues'].items()}
            }
            for cid, c in self.cells.items()
        }


class Scheduler:
    def __init__(self, radio):
        self.radio = radio
        self.running = False

    def run(self):
        self.running = True
        while self.running:
            # Update underlying radio metrics
            self.radio.update_metrics()
            # Very simple scheduler: equal share of capacity per UE
            for cell in self.radio.cells.values():
                ues = list(cell['ues'].values())
                if not ues:
                    continue
                cap = 1000.0
                share = cap / max(1, len(ues))
                for ue in ues:
                    ue['throughput'] = share
            time.sleep(1.0)

    def stop(self):
        self.running = False

    # Helper methods used by the API
    def create_cell(self, cell_id, config=None):
        self.radio.add_cell(cell_id, config)

    def attach_ue(self, cell_id, ue_id):
        self.radio.register_ue(cell_id, ue_id)

    def status(self):
        return self.radio.snapshot()


class UE:
    def __init__(self, ue_id):
        self.id = ue_id
        self.stats = {'rssi': -90.0, 'throughput': 0.0}

    def report(self):
        return {'id': self.id, **self.stats}


def create_app(scheduler):
    app = Flask(__name__)

    @app.route('/v1/cells', methods=['POST'])
    def create_cell():
        data = request.get_json(silent=True) or {}
        cid = data.get('cell_id')
        if not cid:
            return jsonify({'ok': False, 'error': 'cell_id is required'}), 400
        scheduler.create_cell(cid, data.get('config'))
        return jsonify({'ok': True, 'cell_id': cid})

    @app.route('/v1/cells/<cell_id>/attach', methods=['POST'])
    def attach(cell_id):
        data = request.get_json(silent=True) or {}
        ue_id = data.get('ue_id')
        if not ue_id:
            return jsonify({'ok': False, 'error': 'ue_id is required'}), 400
        scheduler.attach_ue(cell_id, ue_id)
        return jsonify({'ok': True, 'cell_id': cell_id, 'ue_id': ue_id})

    @app.route('/v1/status', methods=['GET'])
    def status():
        return jsonify(scheduler.status())

    return app


def main():
    radio = Radio()
    scheduler = Scheduler(radio)

    # Start scheduler thread
    t = threading.Thread(target=scheduler.run, daemon=True)
    t.start()

    # Create and run Flask app
    app = create_app(scheduler)
    # Default host/port match original file's intention
    app.run(host='0.0.0.0', port=8080)


if __name__ == '__main__':
    main()
